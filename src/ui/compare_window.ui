}

.window_control_button {
    background-color: transparent;
    border: none;
    padding: 5px 10px;
    font-size: 12px;
    color: #666;
}

.window_control_button:hover {
    background-color: #d0d0d0;
}

.window_control_button:disabled {
    color: #999;
}

#close_button {
    color: #d32f2f;
}

#close_button:hover {
    background-color: #ffcdd2;
}</string>
